HONEYBAN_IFACE=eth0

# XDP attach mode: driver|generic|hw
# driver is fastest (native). generic is fallback (skb).
HONEYBAN_XDP_MODE=driver

# Enable/disable XDP at runtime (1/0)
HONEYBAN_XDP_ENABLED=1

# Profile: fast|accurate|custom
# fast = max speed (XDP only, detectors off)
# accurate = telemetry + detectors on (recommended)
# custom = use values below
HONEYBAN_PROFILE=accurate

# Optional: additional XDP flags (numeric, OR-ed)
# HONEYBAN_XDP_FLAGS=0

# Optional: override jails config path
# HONEYBAN_JAILS_PATH=/etc/honeyban/jails.conf

# Optional: override filters directory (journald regex filters)
# HONEYBAN_FILTERS_DIR=/etc/honeyban/filters.d
# Optional: override actions directory (action plugin configs)
# HONEYBAN_ACTIONS_DIR=/etc/honeyban/actions.d
# Timeout for action command hooks in milliseconds (10..30000)
# HONEYBAN_ACTION_CMD_TIMEOUT_MS=1000

# Telemetry for userspace detectors (ringbuf). Disable for max throughput.
# Note: synflood/portscan enforcement can still run in-kernel when enabled, even if telemetry is off.
HONEYBAN_TELEMETRY=0

# Userspace detectors (1=on, 0=off)
HONEYBAN_SYN_ENABLED=1
HONEYBAN_PORTSCAN_ENABLED=1
HONEYBAN_SSH_ENABLED=1

# Journald regex filters (recommended for SSH auth detection)
HONEYBAN_JOURNAL_ENABLED=1
# Log backend for filters: auto|journal|file
# auto: use journald if available, else fallback to file log tail
# HONEYBAN_LOG_BACKEND=auto
# Comma-separated files used by file backend
# HONEYBAN_LOG_FILES=/var/log/auth.log,/var/log/secure,/var/log/messages,/var/log/syslog
# Read full files on startup (1) or tail from end (0, recommended)
# HONEYBAN_LOG_READ_FROM_START=0

# Detection engine (confidence + score pipeline before jails).
# Lower min-confidence / score-threshold => more aggressive.
HONEYBAN_DET_MIN_CONFIDENCE=55
HONEYBAN_DET_HIGH_CONF_BYPASS=90
HONEYBAN_DET_SCORE_THRESHOLD=80
HONEYBAN_DET_DECAY_PER_SEC=2
HONEYBAN_DET_SYN_SCORE=8
HONEYBAN_DET_PORTSCAN_SCORE=20
HONEYBAN_DET_SSH_SCORE=30
HONEYBAN_DET_JOURNAL_SCORE=35
HONEYBAN_DET_FORWARD_COOLDOWN_SEC=1

# SYN flood (per source)
HONEYBAN_SYN_THRESHOLD=200
HONEYBAN_SYN_WINDOW_SEC=1

# Portscan (distinct destination ports per source)
HONEYBAN_PORTSCAN_THRESHOLD=20
HONEYBAN_PORTSCAN_WINDOW_SEC=10

# SSH brute-force (journald when available; fallback to TCP connects)
HONEYBAN_SSH_THRESHOLD=8
HONEYBAN_SSH_WINDOW_SEC=120

# Autoban action
HONEYBAN_AUTOBAN_LEVEL=3
HONEYBAN_AUTOBAN_TTL=600

# Optional: override BPF object path
# HONEYBAN_BPF_OBJ_PATH=/usr/local/lib/honeyban/honeyban_xdp.bpf.o
